{
  "name": "budget-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w web",
    "seed": "npm run seed -w server --",
    "backup": "npm run backup -w server --",
    "restore": "npm run restore -w server --",
    "sql": "npm run sql -w server --"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
